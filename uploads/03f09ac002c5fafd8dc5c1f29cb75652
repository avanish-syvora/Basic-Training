### 🧱 10. ADVANCED SCENARIOS

#### a. Emitting between modules

```js
// events.js
const EventEmitter = require('events');
module.exports = new EventEmitter();

// logger.js
const emitter = require('./events');
emitter.emit('logged', { data });

// index.js
emitter.on('logged', () => console.log("Event caught"));
```

You’re now building **event buses**.

---

#### b. Async Emit Chain

You can wrap `.emit()` in `Promise` and chain like this:

```js
function asyncEmit(emitter, event, data) {
  return new Promise(resolve => {
    emitter.emit(event, data);
    setImmediate(resolve);
  });
}
```

---

### 🔄 11. INHERITANCE FROM EventEmitter (How Streams Work)

```js
const { EventEmitter } = require('events');
const util = require('util');

function MyStream() {
  EventEmitter.call(this);
}
util.inherits(MyStream, EventEmitter);

const s = new MyStream();
s.on('data', chunk => console.log(chunk));
s.emit('data', 'Streamed!');
```

