  setTimeout(() => console.log(i), i * 1000);
}
```

➡ Fix this to print `1 2 3` in intervals.

💡 Two ways:
**1. Use `let`:**

```js
for (let i = 1; i <= 3; i++) {
  setTimeout(() => console.log(i), i * 1000);
}
```

**2. Use closure:**

```js
for (var i = 1; i <= 3; i++) {
  (function(j) {
    setTimeout(() => console.log(j), j * 1000);
