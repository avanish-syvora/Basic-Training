  console.log("⏰ Timer 0ms finished");
}, 0);

// Immediate – scheduled for end of current phase
setImmediate(() => {
  console.log("🚀 setImmediate fired");
});

// Microtask – runs before next event loop tick
Promise.resolve().then(() => {
  console.log("🧩 Promise microtask resolved");
});

// Blocking CPU-bound work
const doHeavySyncLoop = () => {
  const start = Date.now();
  while (Date.now() - start < 3000) {} // Block for 3s
  console.log("🔁 Done with CPU-bound blocking loop (3s)");
};
doHeavySyncLoop();

// CPU offloaded to Thread Pool – won't block event loop
crypto.pbkdf2("password", "salt", 100000, 64, "sha512", () => {
  console.log("🔐 PBKDF2 finished (uses thread pool)");
});

console.timeEnd("Total Time");
```

